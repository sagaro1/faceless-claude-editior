# Copy this file to .env.local and fill in what you use. Never commit the real file.

# ElevenLabs: voices, voice-changer (STS), sound effects, Scribe transcripts
ELEVENLABS_API_KEY=

# Cloudflare Workers AI: free background images (images.py). Can also go in .env
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Gemini video API (gemini_video.py) reads this from keys/.env, not from this file:
#   keys/.env  ->  GEMINI_API_KEY=...
